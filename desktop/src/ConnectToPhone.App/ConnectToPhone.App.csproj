<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ConnectToPhone.Core\ConnectToPhone.Core.csproj" />
    <ProjectReference Include="..\ConnectToPhone.Transports\ConnectToPhone.Transports.csproj" />
    <ProjectReference Include="..\ConnectToPhone.Clipboard\ConnectToPhone.Clipboard.csproj" />
    <ProjectReference Include="..\ConnectToPhone.Explorer\ConnectToPhone.Explorer.csproj" />
    <ProjectReference Include="..\ConnectToPhone.Mcp\ConnectToPhone.Mcp.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.101</AssemblyVersion>
    <FileVersion>1.1.0.101</FileVersion>
    <InformationalVersion>1.1.0+build101</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <Resource Include="app_icon.png" />
    <None Update="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="app_icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
