<Window x:Class="ConnectToPhone.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ConnectToPhone ⚡ - High-Speed Sync &amp; Remote" 
        Height="720" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#18181B" Foreground="#FAFAFA"
        Icon="pack://application:,,,/app.ico"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">

    <!-- Windows Taskbar Integration: Live Progress on App Taskbar Icon -->
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="AppTaskbarInfo" ProgressState="None" ProgressValue="0.0" Description="ConnectToPhone" />
    </Window.TaskbarItemInfo>

    <Window.Resources>
        <!-- Nav Button Style -->
        <Style x:Key="NavButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="SidebarNav"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" RecognizesAccessKey="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#27272A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- ComboBox Dark Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0" Background="#121215" BorderBrush="#27272A" BorderThickness="0,0,1,0" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- App Brand with Cool Generated Logo -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4,0,16">
                    <Image Source="app_icon.png" Width="32" Height="32" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ConnectToPhone" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF"/>
                        <TextBlock Text="Ultra Fast Multi-Link" FontSize="11" Foreground="#71717A"/>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Links with ScrollViewer for all screen sizes -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <RadioButton x:Name="NavDashboard" Style="{StaticResource NavButtonStyle}" Content="⚡  Transfer Hub &amp; Speed" IsChecked="True" Checked="Nav_Checked" Click="Nav_Clicked"/>
                        <RadioButton x:Name="NavDevices" Style="{StaticResource NavButtonStyle}" Content="📱  Devices &amp; Pairing" Checked="Nav_Checked" Click="Nav_Clicked"/>
                        <RadioButton x:Name="NavExplorer" Style="{StaticResource NavButtonStyle}" Content="📁  Remote Phone Explorer" Checked="Nav_Checked" Click="Nav_Clicked"/>
                        <RadioButton x:Name="NavClipboard" Style="{StaticResource NavButtonStyle}" Content="📋  Clipboard Sync" Checked="Nav_Checked" Click="Nav_Clicked"/>
                        
                        <TextBlock Text="EXTENSIONS" FontSize="10" FontWeight="Bold" Foreground="#52525B" Margin="10,12,0,6"/>
                        <RadioButton x:Name="NavMirror" Style="{StaticResource NavButtonStyle}" Content="🖥️  Screen Mirror" Checked="Nav_Checked" Click="Nav_Clicked"/>
                        <RadioButton x:Name="NavDisplay" Style="{StaticResource NavButtonStyle}" Content="📐  Virtual Display" Checked="Nav_Checked" Click="Nav_Clicked"/>
                        <RadioButton x:Name="NavRemote" Style="{StaticResource NavButtonStyle}" Content="🎮  PC Remote &amp; Control" Checked="Nav_Checked" Click="Nav_Clicked"/>

                        <TextBlock Text="SYSTEM &amp; STORAGE" FontSize="10" FontWeight="Bold" Foreground="#52525B" Margin="10,12,0,6"/>
                        <RadioButton x:Name="NavCache" Style="{StaticResource NavButtonStyle}" Content="💾  Storage &amp; Cache" Checked="Nav_Checked" Click="Nav_Clicked"/>
                        <RadioButton x:Name="NavMcp" Style="{StaticResource NavButtonStyle}" Content="🤖  MCP AI Server" Checked="Nav_Checked" Click="Nav_Clicked"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer Connection State (Clickable to open Devices & Pairing Hub) -->
                <Border Grid.Row="2" Background="#1E1E24" CornerRadius="8" Padding="10" Margin="0,8,0,0" Cursor="Hand" MouseLeftButtonUp="FooterConnection_Click" ToolTip="Click to open Devices &amp; Pairing Hub">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#EF4444" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtStatus" Text="Waiting for Phone..." FontWeight="SemiBold" FontSize="11" Foreground="#D1D5DB"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtDeviceName" Text="Searching (USB / Wi-Fi)..." FontSize="10" Foreground="#9CA3AF" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header & Device / Protocol Toolbar -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Title & Speed Badges -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock x:Name="TxtViewTitle" Text="Transfer Hub &amp; Live Multi-Path Speed" FontSize="19" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Parallel bonded transmission across Wi-Fi, USB, and Bluetooth" FontSize="11" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Speed Badges in a WrapPanel so they wrap cleanly on smaller windows without overlapping -->
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Border Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,2,6,2">
                            <TextBlock x:Name="TxtUsbBadge" Text="USB: Ready" FontSize="11" FontWeight="Bold" Foreground="#60A5FA"/>
                        </Border>
                        <Border Background="#1E293B" BorderBrush="#10B981" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,2,6,2">
                            <TextBlock x:Name="TxtWifiBadge" Text="Wi-Fi: Ready" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                        </Border>
                        <Border Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,2,6,2">
                            <TextBlock x:Name="TxtBtBadge" Text="Bluetooth: Ready" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                        </Border>
                        <Border Background="#2E1065" BorderBrush="#A855F7" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,2,0,2">
                            <TextBlock x:Name="TxtBondedSpeed" Text="⚡ Bonded: Ready" FontSize="11" FontWeight="Bold" Foreground="#C084FC"/>
                        </Border>
                    </WrapPanel>
                </Grid>

                <!-- Row 1: Interactive Target Device Selector & Protocol Toolbar -->
                <Border Grid.Row="1" Background="#1E1E24" CornerRadius="8" Padding="10,6" Margin="0,10,0,0" BorderBrush="#3F3F46" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Target Device Dropdown -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Target Device:" FontSize="12" FontWeight="SemiBold" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="CmbTargetDevice" Width="210" Height="28" VerticalContentAlignment="Center" SelectionChanged="CmbTargetDevice_SelectionChanged"/>
                        </StackPanel>

                        <!-- Device Action Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <Button x:Name="BtnConnectTarget" Content="🔗 Connect" Background="#2563EB" Foreground="#FFFFFF" FontWeight="SemiBold" Padding="10,4" Margin="0,0,6,0" Click="BtnConnectTarget_Click"/>
                            <Button x:Name="BtnDisconnectTarget" Content="⚡ Disconnect" Background="#7F1D1D" Foreground="#FCA5A5" FontWeight="SemiBold" Padding="10,4" Margin="0,0,6,0" Click="BtnDisconnectTarget_Click"/>
                            <Button x:Name="BtnPairNewDevice" Content="➕ Pair Device" Background="#3F3F46" Foreground="#FFFFFF" FontWeight="SemiBold" Padding="10,4" Margin="0,0,6,0" Click="BtnPairNewDevice_Click"/>
                        </StackPanel>

                        <!-- Protocol Disconnect/Reconnect Toggles -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Protocols:" FontSize="11" Foreground="#71717A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button x:Name="BtnToggleUsb" Content="⚡ USB: On" Background="#1E293B" Foreground="#60A5FA" FontSize="11" FontWeight="SemiBold" Padding="8,4" Margin="0,0,4,0" ToolTip="Click to disconnect or reconnect USB protocol" Click="BtnToggleUsb_Click"/>
                            <Button x:Name="BtnToggleWifi" Content="📶 Wi-Fi: On" Background="#064E3B" Foreground="#34D399" FontSize="11" FontWeight="SemiBold" Padding="8,4" Margin="0,0,4,0" ToolTip="Click to disconnect or reconnect Wi-Fi protocol" Click="BtnToggleWifi_Click"/>
                            <Button x:Name="BtnToggleBt" Content="📱 BT: On" Background="#312E81" Foreground="#818CF8" FontSize="11" FontWeight="SemiBold" Padding="8,4" ToolTip="Click to disconnect or reconnect Bluetooth protocol" Click="BtnToggleBt_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- VIEW 1: DASHBOARD / TRANSFER HUB -->
            <Grid x:Name="ViewDashboard" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Active Transfer Progress Card -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- File Info -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock x:Name="TxtCurrentFileName" Text="Ready for fast multi-path transfer" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                <TextBlock x:Name="TxtTransferDetails" Text="Drag &amp; drop files below, click Browse, or pull from phone explorer" FontSize="12" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="BtnPause" Content="⏸ Pause" Background="#3F3F46" Foreground="#FFFFFF" Margin="0,0,8,0" Padding="12,6" Click="BtnPause_Click"/>
                                <Button x:Name="BtnCancel" Content="✕ Cancel" Background="#7F1D1D" Foreground="#FCA5A5" Padding="12,6" Click="BtnCancel_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- High Speed Progress Bar -->
                        <ProgressBar Grid.Row="1" x:Name="TransferProgressBar" Height="8" Minimum="0" Maximum="100" Value="0" Background="#3F3F46" Foreground="#3B82F6"/>

                        <!-- Transfer Stats Breakdown -->
                        <Grid Grid.Row="2" Margin="0,8,0,0">
                            <TextBlock x:Name="TxtTransferRate" Text="Idle" FontSize="11" Foreground="#9CA3AF"/>
                            <TextBlock x:Name="TxtEta" Text="ETA: -" FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Right"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Drag & Drop Zone + Quick Actions -->
                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>

                    <!-- Drop Target with full-box click support -->
                    <Border Grid.Column="0" BorderBrush="#3F3F46" BorderThickness="2" CornerRadius="12" Background="#1E1E24" AllowDrop="True" Drop="DropZone_Drop" DragOver="DropZone_DragOver" MouseLeftButtonUp="DropZone_Click" Cursor="Hand" Margin="0,0,16,0">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="📁" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="Click or Drag Files Here to Send" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                            <TextBlock Text="Files will be bonded across USB 2.0/3.0, Wi-Fi, and Bluetooth" FontSize="12" Foreground="#71717A" HorizontalAlignment="Center" Margin="0,4,0,14"/>
                            <Button Content="Browse Files to Send..." Background="#2563EB" Foreground="#FFFFFF" FontWeight="SemiBold" Padding="16,8" HorizontalAlignment="Center" Click="BtnBrowseSend_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Quick Folder Shortcuts -->
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Quick Folders" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" Margin="0,0,0,12"/>
                            
                            <Button Content="🎬 D:\movies (Test Media)" Background="#1E293B" Foreground="#93C5FD" FontWeight="SemiBold" Padding="12,8" Margin="0,0,0,8" HorizontalContentAlignment="Left" Click="BtnOpenMovies_Click"/>
                            <Button Content="📥 Windows Downloads" Background="#1E293B" Foreground="#93C5FD" FontWeight="SemiBold" Padding="12,8" Margin="0,0,0,8" HorizontalContentAlignment="Left" Click="BtnOpenDownloads_Click"/>
                            <Button Content="⚡ Force USB Connect" Background="#14532D" Foreground="#86EFAC" FontWeight="SemiBold" Padding="12,8" HorizontalContentAlignment="Left" Click="BtnForceConnect_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Activity / History Console -->
                <Border Grid.Row="2" Height="140" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Live Transfer Activity &amp; Protocol Logs" FontWeight="Bold" FontSize="12" Foreground="#A1A1AA" Margin="0,0,0,6"/>
                        <ListBox Grid.Row="1" x:Name="ListActivity" Background="Transparent" BorderThickness="0" Foreground="#10B981" FontFamily="Consolas, monospace" FontSize="11" MouseDoubleClick="ListActivity_MouseDoubleClick"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- VIEW 2: REMOTE PHONE EXPLORER -->
            <Grid x:Name="ViewExplorer" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Path & Navigation Bar -->
                <Border Grid.Row="0" Background="#27272A" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="⬅ Back" Background="Transparent" Foreground="#60A5FA" BorderThickness="0" Padding="8,4" Click="BtnExplorerBack_Click"/>
                        <TextBlock Grid.Column="1" x:Name="TxtExplorerPath" Text="/storage/emulated/0" VerticalAlignment="Center" Foreground="#FFFFFF" Margin="12,0"/>
                        <Button Grid.Column="2" Content="🔄 Refresh" Background="Transparent" Foreground="#60A5FA" BorderThickness="0" Padding="8,4" Click="BtnExplorerRefresh_Click"/>
                    </Grid>
                </Border>

                <!-- Entries List -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <ListView x:Name="ListPhoneEntries" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" MouseDoubleClick="ListPhoneEntries_MouseDoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" Width="380" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Type" Width="100" DisplayMemberBinding="{Binding Category}"/>
                                <GridViewColumn Header="Size" Width="120" DisplayMemberBinding="{Binding SizeDisplay}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>

                <!-- Action Bar -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button x:Name="BtnQuickViewSelected" Content="👁️ Quick View (Cache)" Background="#10B981" Foreground="#FFFFFF" FontWeight="Bold" Padding="16,10" Margin="0,0,8,0" Click="BtnQuickViewSelected_Click"/>
                    <Button Content="⬇ Download Selected to PC" Background="#3B82F6" Foreground="#FFFFFF" FontWeight="Bold" Padding="20,10" Click="BtnDownloadSelected_Click"/>
                </StackPanel>
            </Grid>

            <!-- VIEW 3: CLIPBOARD SYNC -->
            <Grid x:Name="ViewClipboard" Grid.Row="1" Visibility="Collapsed">
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="ChkAutoClip" Content="Enable Real-Time Bidirectional Clipboard Sync" IsChecked="True" Foreground="#FFFFFF" FontWeight="Bold" VerticalAlignment="Center" Checked="ChkAutoClip_Changed" Unchecked="ChkAutoClip_Changed"/>
                            </StackPanel>
                            <TextBlock Text="Copies on Windows appear instantly on Phone. Copies on Phone appear instantly on Windows." FontSize="12" Foreground="#A1A1AA" Margin="24,4,0,0"/>
                        </StackPanel>

                        <ListView Grid.Row="1" x:Name="ListClipboardHistory" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- VIEW 2: DEVICES & PAIRING HUB -->
            <Grid x:Name="ViewDevices" Grid.Row="1" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,8,16">

                        <!-- SECTION 1: ACTIVE CONNECTED DEVICE HERO CARD (OR AWAITING STATE) -->
                        <!-- 1A: Connected State Hero Card -->
                        <Border x:Name="CardActiveDeviceHero" CornerRadius="12" Padding="20,16" Margin="0,0,0,16" BorderBrush="#3B82F6" BorderThickness="1.5" Visibility="Collapsed">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1E293B" Offset="0"/>
                                    <GradientStop Color="#0F172A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0: Top Status Pill & Hardware Avatar -->
                                <Grid Grid.Row="0" Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Hardware Avatar -->
                                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" Background="#2563EB" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="📱" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Name & Serial -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtConnectedHeroName" Text="Connected Android Device" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            <Border Background="#064E3B" CornerRadius="12" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="● ONLINE &amp; BONDED" FontWeight="Bold" FontSize="10" Foreground="#34D399"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtConnectedHeroId" Text="Hardware ID: DEV_ACTIVE • Authorized Peer" FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <!-- Action Buttons Row -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="BtnForceSyncHero" Content="🔄 Force Sync Now" Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" Padding="12,7" Margin="0,0,8,0" Click="BtnForceSync_Click" ToolTip="Immediately push clipboard, refresh file explorer, and ping device"/>
                                        <Button x:Name="BtnDisconnectHero" Content="⚡ Disconnect" Background="#3F3F46" Foreground="#FFFFFF" FontWeight="SemiBold" Padding="12,7" Margin="0,0,8,0" Click="BtnDisconnectSelectedDevice_Click"/>
                                        <Button x:Name="BtnUnpairHero" Content="✕ Unpair" Background="#7F1D1D" Foreground="#FCA5A5" FontWeight="SemiBold" Padding="12,7" Click="BtnUnpair_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 1: Telemetry Metrics Grid -->
                                <Border Grid.Row="1" Background="#131B2E" CornerRadius="8" Padding="12,10" Margin="0,0,0,12" BorderBrush="#1E3A8A" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="ACTIVE TRANSPORTS" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                            <TextBlock x:Name="TxtHeroTransports" Text="Bonded: USB + Wi-Fi" FontSize="12" FontWeight="Bold" Foreground="#60A5FA" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="SYNC LATENCY" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                            <TextBlock x:Name="TxtHeroLatency" Text="&lt; 2 ms (Ultra Low)" FontSize="12" FontWeight="Bold" Foreground="#34D399" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="MAX PIPELINE" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                            <TextBlock x:Name="TxtHeroPipeline" Text="Bonded Multi-Path" FontSize="12" FontWeight="Bold" Foreground="#C084FC" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="POWER EFFICIENCY" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                            <TextBlock Text="Zero-Idle (0% CPU)" FontSize="12" FontWeight="Bold" Foreground="#FBBF24" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Row 2: Subsystem Status Chips -->
                                <WrapPanel Grid.Row="2">
                                    <Border Background="#1E293B" CornerRadius="6" Padding="8,4" Margin="0,0,8,4">
                                        <TextBlock Text="📋 Clipboard Sync: Live" FontSize="11" Foreground="#93C5FD"/>
                                    </Border>
                                    <Border Background="#1E293B" CornerRadius="6" Padding="8,4" Margin="0,0,8,4">
                                        <TextBlock Text="📁 Remote Explorer: Synced" FontSize="11" Foreground="#93C5FD"/>
                                    </Border>
                                    <Border Background="#1E293B" CornerRadius="6" Padding="8,4" Margin="0,0,8,4">
                                        <TextBlock Text="🎮 PC Remote Control: Enabled" FontSize="11" Foreground="#93C5FD"/>
                                    </Border>
                                    <Border Background="#1E293B" CornerRadius="6" Padding="8,4" Margin="0,0,0,4">
                                        <TextBlock Text="💾 Safe Non-C Storage: Active" FontSize="11" Foreground="#34D399"/>
                                    </Border>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <!-- 1B: Disconnected Empty State Hero Card -->
                        <Border x:Name="CardDisconnectedHero" Style="{StaticResource CardStyle}" Margin="0,0,0,16" Visibility="Visible">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="52" Height="52" CornerRadius="26" Background="#27272A" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="📡" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Awaiting Device Connection" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock x:Name="TxtDisconnectedHostInfo" Text="Connect via USB cable, scan the QR code below, or join the same Wi-Fi LAN." FontSize="12" Foreground="#A1A1AA" Margin="0,3,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Border Background="#18181B" CornerRadius="6" Padding="8,3" Margin="0,0,8,0">
                                            <TextBlock x:Name="TxtLocalIpBadge" Text="Host IP: Resolving..." FontSize="11" Foreground="#60A5FA" FontFamily="Consolas"/>
                                        </Border>
                                        <Border Background="#18181B" CornerRadius="6" Padding="8,3">
                                            <TextBlock Text="Discovery Beacon: Active (UDP 42425)" FontSize="11" Foreground="#34D399"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <Button x:Name="BtnRescanUsbAdb" Content="⚡ Rescan USB ADB" Background="#15803D" Foreground="#FFFFFF" FontWeight="Bold" Padding="14,8" Click="BtnScanAdb_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- SECTION 2: PAIR NEW DEVICE WIZARD (QR CODE & PIN PAIRING) -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- CARD 2A: Instant QR Code Scan -->
                            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0" BorderBrush="#2563EB" BorderThickness="1.5">
                                <StackPanel>
                                    <TextBlock Text="📱 Instant QR Code Pairing" FontSize="15" FontWeight="Bold" Foreground="#60A5FA"/>
                                    <TextBlock Text="Point your phone camera or tap 'Scan QR' in ConnectToWindow to link instantly without typing:" FontSize="11" Foreground="#A1A1AA" Margin="0,2,0,10"/>

                                    <!-- QR Code Container -->
                                    <Border Background="#FFFFFF" CornerRadius="8" Padding="10" HorizontalAlignment="Center" Margin="0,4,0,10">
                                        <Image x:Name="ImgQrCode" Width="170" Height="170" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    </Border>

                                    <TextBlock x:Name="TxtQrInfo" Text="connecttowindow://pair?..." FontSize="10" Foreground="#71717A" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>

                                    <!-- QR Action Buttons -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" x:Name="BtnRegenQr" Content="🔄 New QR &amp; PIN" Background="#3F3F46" Foreground="#FFFFFF" FontWeight="SemiBold" Padding="10,6" Margin="0,0,4,0" Click="BtnRegenQr_Click"/>
                                        <Button Grid.Column="1" x:Name="BtnCopyPairUrl" Content="📋 Copy Pair Link" Background="#2563EB" Foreground="#FFFFFF" FontWeight="SemiBold" Padding="10,6" Margin="4,0,0,0" Click="BtnCopyPairUrl_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- CARD 2B: 6-Digit Match PIN & Manual Pair -->
                            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0" BorderBrush="#10B981" BorderThickness="1.5">
                                <StackPanel>
                                    <TextBlock Text="🔒 6-Digit Security Match PIN" FontSize="15" FontWeight="Bold" Foreground="#34D399"/>
                                    <TextBlock Text="Enter this PIN on your phone, or compare digits to authorize peer connection:" FontSize="11" Foreground="#A1A1AA" Margin="0,2,0,10"/>

                                    <!-- Large Segmented PIN Display -->
                                    <Border Background="#18181B" BorderBrush="#10B981" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,4,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TxtPinSegmented" Text="8 4 9  -  2 0 1" FontSize="24" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas, monospace"/>
                                            <TextBlock x:Name="TxtPin" Text="------" Visibility="Collapsed"/>
                                            <Button Grid.Column="1" x:Name="BtnCopyPin" Content="📋 Copy" Background="#064E3B" Foreground="#86EFAC" FontWeight="SemiBold" Padding="8,4" Click="BtnCopyPin_Click" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <Separator Background="#3F3F46" Margin="0,6,0,10"/>

                                    <!-- Mutual Authorize Phone PIN -->
                                    <TextBlock Text="Authorize Phone PIN (if phone generated one):" FontSize="12" FontWeight="SemiBold" Foreground="#E4E4E7" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="TxtPairDeviceName" Text="Android Phone" Height="30" Background="#27272A" Foreground="#FFFFFF" BorderBrush="#3F3F46" VerticalContentAlignment="Center" Padding="6,2" Margin="0,0,6,0"/>
                                        <TextBox Grid.Column="1" x:Name="TxtPairPinInput" Text="" Height="30" Background="#27272A" Foreground="#34D399" BorderBrush="#3F3F46" VerticalContentAlignment="Center" Padding="6,2" Margin="0,0,6,0" MaxLength="6" FontFamily="Consolas"/>
                                        <Button Grid.Column="2" x:Name="BtnSubmitPair" Content="➕ Pair" Background="#15803D" Foreground="#FFFFFF" FontWeight="Bold" Padding="14,6" Click="BtnSubmitPair_Click"/>
                                    </Grid>
                                    <TextBlock Text="Enter the 6-digit PIN displayed on your mobile device." FontSize="10" Foreground="#71717A"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- SECTION 3: NEARBY RADAR DISCOVERY & DIRECT CONNECT -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="📡 Discovered Nearby Phones &amp; Devices" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        <TextBlock Text="Phones detected broadcasting on your local Wi-Fi subnet (UDP 42425) or Bluetooth pairing range:" FontSize="11" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="BtnRefreshDiscovered" Content="🔄 Refresh Radar" Background="#3F3F46" Foreground="#FFFFFF" Padding="10,4" Click="BtnRefreshDiscovered_Click"/>
                                </Grid>

                                <!-- Discovered Devices ListView -->
                                <ListView x:Name="ListDiscoveredDevices" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" MinHeight="80" MaxHeight="140" Margin="0,0,0,10">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Device Name" Width="220" DisplayMemberBinding="{Binding DeviceName}"/>
                                            <GridViewColumn Header="Endpoint / IP" Width="180" DisplayMemberBinding="{Binding Endpoint}"/>
                                            <GridViewColumn Header="Protocol" Width="120" DisplayMemberBinding="{Binding TransportBadge}"/>
                                            <GridViewColumn Header="Last Seen" Width="100" DisplayMemberBinding="{Binding LastSeenDisplay}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                                    <Button x:Name="BtnConnectDiscovered" Content="🔗 1-Tap Connect Selected" Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" Padding="14,6" Click="BtnConnectDiscovered_Click"/>
                                </StackPanel>

                                <!-- Manual Direct IP / Port Fallback -->
                                <Border Background="#1E1E24" CornerRadius="8" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Direct Manual IP:" FontSize="12" Foreground="#D1D5DB" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Grid.Column="1" x:Name="TxtDirectIp" Text="192.168.250.225" Width="140" Height="28" Background="#27272A" Foreground="#FFFFFF" BorderBrush="#3F3F46" VerticalContentAlignment="Center" Padding="6,2" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="2" Text="Port:" FontSize="12" Foreground="#D1D5DB" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox Grid.Column="3" x:Name="TxtDirectPort" Text="42424" Width="60" Height="28" Background="#27272A" Foreground="#FFFFFF" BorderBrush="#3F3F46" VerticalContentAlignment="Center" Padding="6,2" Margin="0,0,10,0"/>
                                        <Button Grid.Column="4" x:Name="BtnDirectConnect" Content="🔗 Connect to IP" Background="#2563EB" Foreground="#FFFFFF" FontWeight="SemiBold" Padding="12,5" HorizontalAlignment="Left" Click="BtnDirectConnect_Click"/>
                                        <Button Grid.Column="5" x:Name="BtnScanAdb" Content="⚡ Rescan USB Devices" Background="#15803D" Foreground="#FFFFFF" FontWeight="SemiBold" Padding="12,5" Click="BtnScanAdb_Click"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- SECTION 4: PAIRED & TRUSTED DEVICES HISTORY -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="📱 Paired &amp; Known Devices History" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        <TextBlock Text="Remembered devices with stored trust tokens for instant re-attachment without typing PINs:" FontSize="11" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="BtnRefreshDevices" Content="🔄 Refresh List" Background="#3F3F46" Foreground="#FFFFFF" Padding="10,4" Click="BtnRefreshDevices_Click"/>
                                </Grid>

                                <ListView x:Name="ListPairedDevices" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" MinHeight="90" MaxHeight="150">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Device Name" Width="260" DisplayMemberBinding="{Binding DeviceName}"/>
                                            <GridViewColumn Header="Device ID / Serial" Width="220" DisplayMemberBinding="{Binding DeviceId}"/>
                                            <GridViewColumn Header="Type" Width="110" DisplayMemberBinding="{Binding DeviceType}"/>
                                            <GridViewColumn Header="Status" Width="130" DisplayMemberBinding="{Binding TrustStatus}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button x:Name="BtnConnectSelectedDevice" Content="🔗 Connect Selected" Background="#2563EB" Foreground="#FFFFFF" FontWeight="SemiBold" Padding="14,6" Margin="0,0,8,0" Click="BtnConnectSelectedDevice_Click"/>
                                    <Button x:Name="BtnDisconnectSelectedDevice" Content="⚡ Disconnect Selected" Background="#3F3F46" Foreground="#FFFFFF" FontWeight="SemiBold" Padding="14,6" Margin="0,0,8,0" Click="BtnDisconnectSelectedDevice_Click"/>
                                    <Button x:Name="BtnUnpair" Content="✕ Unpair Selected Device" Background="#7F1D1D" Foreground="#FCA5A5" FontWeight="SemiBold" Padding="14,6" Click="BtnUnpair_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- SECTION 5: PROTOCOL CONNECTION SWITCHES -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="⚡ Protocol Connection Settings &amp; Overrides" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Explicitly enable, disable, or disconnect individual transport links:" FontSize="11" Foreground="#A1A1AA" Margin="0,2,0,10"/>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- USB Control Box -->
                                    <Border Grid.Column="0" Background="#18181B" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="⚡ USB ADB Bridge" FontWeight="Bold" FontSize="13" Foreground="#60A5FA"/>
                                            <TextBlock x:Name="TxtDetailUsbStatus" Text="Status: Ready / Scanning" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,8"/>
                                            <Button x:Name="BtnDetailUsbToggle" Content="⚡ Disconnect USB" Background="#1E293B" Foreground="#93C5FD" FontWeight="SemiBold" Padding="8,5" Click="BtnToggleUsb_Click"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Wi-Fi Control Box -->
                                    <Border Grid.Column="1" Background="#18181B" BorderBrush="#10B981" BorderThickness="1" CornerRadius="8" Padding="10" Margin="3,0,3,0">
                                        <StackPanel>
                                            <TextBlock Text="📶 Wi-Fi LAN (Port 42424)" FontWeight="Bold" FontSize="13" Foreground="#34D399"/>
                                            <TextBlock x:Name="TxtDetailWifiStatus" Text="Status: Server Active" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,8"/>
                                            <Button x:Name="BtnDetailWifiToggle" Content="📶 Disconnect Wi-Fi" Background="#064E3B" Foreground="#86EFAC" FontWeight="SemiBold" Padding="8,5" Click="BtnToggleWifi_Click"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Bluetooth Control Box -->
                                    <Border Grid.Column="2" Background="#18181B" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="8" Padding="10" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="📱 Bluetooth RFCOMM" FontWeight="Bold" FontSize="13" Foreground="#38BDF8"/>
                                            <TextBlock x:Name="TxtDetailBtStatus" Text="Status: Ready / Listening" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,8"/>
                                            <Button x:Name="BtnDetailBtToggle" Content="📱 Disconnect BT" Background="#312E81" Foreground="#C7D2FE" FontWeight="SemiBold" Padding="8,5" Click="BtnToggleBt_Click"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- SECTION 6: VIRTUAL MULTI-DEVICE SIMULATION & FAILOVER LAB -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="🧪 Multi-Device Simulation &amp; Failover Testing Lab" FontSize="15" FontWeight="Bold" Foreground="#A78BFA"/>
                                <TextBlock Text="Simulate multiple virtual Android devices in memory. Browse realistic simulated Android file trees, stream high-speed test chunks (~80 MB/s), and simulate mid-transfer channel disconnects to test zero-loss bonded failover." FontSize="11" Foreground="#A1A1AA" Margin="0,2,0,10"/>

                                <WrapPanel Margin="0,0,0,8">
                                    <Button x:Name="BtnSpawnGalaxyTab" Content="📱 Spawn Galaxy Tab S9 (Virtual)" Background="#1E3A8A" Foreground="#93C5FD" FontWeight="SemiBold" Padding="12,6" Margin="0,0,8,6" Click="BtnSpawnGalaxyTab_Click"/>
                                    <Button x:Name="BtnSpawnPixel8" Content="📱 Spawn Pixel 8 Pro (Virtual)" Background="#064E3B" Foreground="#86EFAC" FontWeight="SemiBold" Padding="12,6" Margin="0,0,8,6" Click="BtnSpawnPixel8_Click"/>
                                    <Button x:Name="BtnSimulateDrop" Content="⚡ Simulate Wi-Fi Drop (Failover Test)" Background="#7F1D1D" Foreground="#FCA5A5" FontWeight="SemiBold" Padding="12,6" Margin="0,0,8,6" Click="BtnSimulateDrop_Click"/>
                                    <Button x:Name="BtnSimulateReconnect" Content="🔄 Simulate Link Reconnect" Background="#14532D" Foreground="#86EFAC" FontWeight="SemiBold" Padding="12,6" Margin="0,0,8,6" Click="BtnSimulateReconnect_Click"/>
                                    <Button x:Name="BtnRemoveSimulated" Content="🗑 Remove Virtual Devices" Background="#3F3F46" Foreground="#D1D5DB" Padding="12,6" Margin="0,0,0,6" Click="BtnRemoveSimulated_Click"/>
                                </WrapPanel>

                                <Border Background="#18181B" CornerRadius="8" Padding="10,6">
                                    <TextBlock x:Name="TxtSimulationStatus" Text="Simulation Engine: Ready. No virtual devices spawned. Tap 'Spawn' above to simulate." FontSize="11" Foreground="#A78BFA"/>
                                </Border>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- VIEW: CACHE & STORAGE MANAGEMENT -->
            <Grid x:Name="ViewCache" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Storage Info Header Card -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Drive &amp; Preview Cache Manager" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Quickly preview remote files in high-speed disk cache without cluttering downloads. LRU quota automatically evicts oldest preview files." FontSize="12" Foreground="#A1A1AA" Margin="0,4,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#1E1E24" CornerRadius="8" Padding="12,8" Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="STORAGE TARGET (NON-C PROTECTED)" FontSize="10" FontWeight="Bold" Foreground="#71717A"/>
                                        <TextBlock x:Name="TxtCacheDrive" Text="D:\ (Safe Drive)" FontSize="14" FontWeight="Bold" Foreground="#60A5FA"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#1E1E24" CornerRadius="8" Padding="12,8" Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="DRIVE FREE SPACE" FontSize="10" FontWeight="Bold" Foreground="#71717A"/>
                                        <TextBlock x:Name="TxtDriveFree" Text="-- GB Free" FontSize="14" FontWeight="Bold" Foreground="#34D399"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#1E1E24" CornerRadius="8" Padding="12,8">
                                    <StackPanel>
                                        <TextBlock Text="PREVIEW CACHE USED" FontSize="10" FontWeight="Bold" Foreground="#71717A"/>
                                        <TextBlock x:Name="TxtCacheUsed" Text="0 MB / 500 MB Quota" FontSize="14" FontWeight="Bold" Foreground="#F59E0B"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button x:Name="BtnClearAllCache" Content="🧹 Clear All Cache" Background="#7F1D1D" Foreground="#FCA5A5" FontWeight="Bold" Padding="14,8" Margin="0,0,0,8" Click="BtnClearAllCache_Click"/>
                            <Button x:Name="BtnOpenCacheFolder" Content="📁 Open Cache Folder" Background="#27272A" Foreground="#FFFFFF" Padding="14,6" Click="BtnOpenCacheFolder_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Cached Items List with Category Filter -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Cached Preview Files:" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <RadioButton x:Name="FilterCacheAll" Content="All" IsChecked="True" Foreground="#E4E4E7" Margin="0,0,12,0" Checked="FilterCache_Changed"/>
                            <RadioButton x:Name="FilterCacheImages" Content="Images" Foreground="#E4E4E7" Margin="0,0,12,0" Checked="FilterCache_Changed"/>
                            <RadioButton x:Name="FilterCacheDocs" Content="Documents" Foreground="#E4E4E7" Margin="0,0,12,0" Checked="FilterCache_Changed"/>
                            <RadioButton x:Name="FilterCacheMedia" Content="Media" Foreground="#E4E4E7" Margin="0,0,12,0" Checked="FilterCache_Changed"/>
                            <RadioButton x:Name="FilterCacheOther" Content="Other" Foreground="#E4E4E7" Checked="FilterCache_Changed"/>
                        </StackPanel>

                        <ListView Grid.Row="1" x:Name="ListCachedFiles" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" MouseDoubleClick="ListCachedFiles_MouseDoubleClick">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="File Name" Width="360" DisplayMemberBinding="{Binding FileName}"/>
                                    <GridViewColumn Header="Category" Width="100" DisplayMemberBinding="{Binding Category}"/>
                                    <GridViewColumn Header="Size" Width="100" DisplayMemberBinding="{Binding SizeDisplay}"/>
                                    <GridViewColumn Header="Last Accessed" Width="140" DisplayMemberBinding="{Binding LastAccessedUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </Border>

                <!-- Storage Path Configuration Footer -->
                <Border Grid.Row="2" Background="#1E1E24" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Configured Storage Paths (Strict Non-C Allocation):" FontWeight="Bold" FontSize="11" Foreground="#A1A1AA"/>
                            <TextBlock x:Name="TxtCachePath" Text="Cache: D:\ConnectToPhone\Cache" FontSize="11" Foreground="#71717A" Margin="0,2,0,0"/>
                            <TextBlock x:Name="TxtDownloadsPath" Text="Downloads: D:\ConnectToPhone\Downloads" FontSize="11" Foreground="#71717A" Margin="0,1,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="🗑 Delete Selected" Background="#3F3F46" Foreground="#FFFFFF" Padding="12,6" Margin="0,0,8,0" Click="BtnDeleteSelectedCache_Click"/>
                            <Button Content="👁️ Open Selected" Background="#2563EB" Foreground="#FFFFFF" FontWeight="SemiBold" Padding="12,6" Click="BtnOpenSelectedCache_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- VIEW 5: MCP SERVER & AI TOOLS -->
            <Grid x:Name="ViewMcp" Grid.Row="1" Visibility="Collapsed">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Model Context Protocol (MCP) Server" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="AI assistants (like Claude, Gemini, Antigravity) can connect directly to ConnectToPhone to browse phone files, transfer data, and interact with the device." FontSize="13" Foreground="#A1A1AA" Margin="0,6,0,16"/>

                        <Border Background="#18181B" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="STDIO Command configuration (claude_desktop_config.json / mcp.json):" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,8"/>
                                <TextBox Text="dotnet run --project ConnectToPhone.App.csproj -- --mcp" IsReadOnly="True" Background="#27272A" Foreground="#34D399" BorderThickness="0" Padding="8"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Available Tools Exposed to AI:" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,8,0,8"/>
                        <TextBlock Text="• phone_get_status(): Connection health, active transports, speeds" Foreground="#D1D5DB" Margin="8,2"/>
                        <TextBlock Text="• phone_list_files(path): Remote directory explorer" Foreground="#D1D5DB" Margin="8,2"/>
                        <TextBlock Text="• phone_download_file(phone_path, local_path): Direct phone-to-PC download" Foreground="#D1D5DB" Margin="8,2"/>
                        <TextBlock Text="• phone_upload_file(local_path, phone_path): Direct PC-to-phone upload" Foreground="#D1D5DB" Margin="8,2"/>
                        <TextBlock Text="• phone_get_clipboard() / phone_set_clipboard(text): Clipboard sync" Foreground="#D1D5DB" Margin="8,2"/>
                        <TextBlock Text="• phone_show_notification(title, message): Push alert to mobile screen" Foreground="#D1D5DB" Margin="8,2"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- VIEW 6: EXTENSIONS (Screen Mirror, Virtual Display, Remote Control) -->
            <Grid x:Name="ViewExtensions" Grid.Row="1" Visibility="Collapsed">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtExtensionIcon" Text="🎮" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock x:Name="TxtExtensionTitle" Text="PC Remote &amp; Utility Control" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtExtensionDesc" Text="Control your Windows PC wirelessly from your phone screen." FontSize="13" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,6,0,16"/>
                        <Border Background="#1E1E24" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Supported Remote Gestures &amp; Controls:" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,8"/>
                                <TextBlock Text="• Touchpad Mouse: Drag to move, single tap left click, two finger tap right click" Foreground="#D1D5DB" Margin="4,2"/>
                                <TextBlock Text="• Dual Scroll Wheels: Vertical &amp; Horizontal smooth scrolling" Foreground="#D1D5DB" Margin="4,2"/>
                                <TextBlock Text="• Remote Keyboard: Send any text or hotkeys (Alt+Tab, Win+D, Ctrl+C, Ctrl+V)" Foreground="#D1D5DB" Margin="4,2"/>
                                <TextBlock Text="• Media &amp; Power: Volume up/down, Play/Pause, Lock, Sleep" Foreground="#D1D5DB" Margin="4,2"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
